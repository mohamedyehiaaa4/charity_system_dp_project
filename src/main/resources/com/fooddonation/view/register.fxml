<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.fooddonation.controller.RegisterController" styleClass="auth-page">
    <VBox styleClass="card" maxWidth="520" maxHeight="-Infinity" spacing="14">
        <Label text="Register as a donor" styleClass="title"/>
        <GridPane styleClass="form" hgap="12" vgap="10">
            <columnConstraints>
                <ColumnConstraints minWidth="130"/>
                <ColumnConstraints hgrow="ALWAYS"/>
            </columnConstraints>
            <Label text="Name" GridPane.rowIndex="0"/>
            <TextField fx:id="nameField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
            <Label text="Email" GridPane.rowIndex="1"/>
            <TextField fx:id="emailField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
            <Label text="Phone" GridPane.rowIndex="2"/>
            <TextField fx:id="phoneField" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
            <Label text="Address" GridPane.rowIndex="3"/>
            <TextField fx:id="addressField" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
            <Label text="Donor type" GridPane.rowIndex="4"/>
            <ComboBox fx:id="donorTypeBox" maxWidth="Infinity" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
            <Label text="Notify me by" GridPane.rowIndex="5"/>
            <ComboBox fx:id="channelBox" maxWidth="Infinity" GridPane.rowIndex="5" GridPane.columnIndex="1"/>
        </GridPane>
        <HBox spacing="10">
            <Button text="Register" defaultButton="true" onAction="#register" styleClass="primary"/>
            <Button text="Back to sign in" cancelButton="true" onAction="#back"/>
        </HBox>
        <Label fx:id="message" wrapText="true" styleClass="message"/>
    </VBox>
</StackPane>
