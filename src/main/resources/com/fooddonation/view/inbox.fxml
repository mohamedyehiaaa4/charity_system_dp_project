<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.fooddonation.controller.InboxController" styleClass="page" spacing="12">
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label fx:id="summary" styleClass="muted"/>
        <Pane HBox.hgrow="ALWAYS"/>
        <Button text="Refresh" onAction="#refresh"/>
    </HBox>
    <SplitPane dividerPositions="0.45" VBox.vgrow="ALWAYS">
        <TableView fx:id="table">
            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
            <columns>
                <TableColumn fx:id="timeColumn" text="Received" prefWidth="130"/>
                <TableColumn fx:id="subjectColumn" text="Subject" prefWidth="220"/>
            </columns>
        </TableView>
        <TextArea fx:id="body" editable="false" wrapText="true" styleClass="document"
                  promptText="Select a message to read it."/>
    </SplitPane>
</VBox>
