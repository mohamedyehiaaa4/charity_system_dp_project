<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.fooddonation.controller.MyDonationsController" styleClass="page" spacing="16">
    <HBox spacing="10" alignment="BOTTOM_LEFT">
        <VBox spacing="2">
            <Label text="My donations" styleClass="page-title"/>
            <Label text="Follow each donation from submission to delivery." styleClass="muted"/>
        </VBox>
        <Pane HBox.hgrow="ALWAYS"/>
        <Label text="Tax year" styleClass="muted"/>
        <Spinner fx:id="yearSpinner" prefWidth="95" editable="true"/>
        <Button text="Annual summary" onAction="#showAnnualSummary"/>
    </HBox>

    <HBox spacing="14">
        <VBox styleClass="stat" HBox.hgrow="ALWAYS" maxWidth="Infinity">
            <Label text="Total donations" styleClass="stat-label"/>
            <Label fx:id="totalValue" styleClass="stat-value"/>
        </VBox>
        <VBox styleClass="stat" HBox.hgrow="ALWAYS" maxWidth="Infinity">
            <Label text="Food donations" styleClass="stat-label"/>
            <Label fx:id="foodValue" styleClass="stat-value"/>
        </VBox>
        <VBox styleClass="stat" HBox.hgrow="ALWAYS" maxWidth="Infinity">
            <Label text="Money donated" styleClass="stat-label"/>
            <Label fx:id="moneyValue" styleClass="stat-value"/>
        </VBox>
        <VBox styleClass="stat" HBox.hgrow="ALWAYS" maxWidth="Infinity">
            <Label text="In progress" styleClass="stat-label"/>
            <Label fx:id="progressValue" styleClass="stat-value"/>
        </VBox>
    </HBox>

    <Label fx:id="message" wrapText="true" styleClass="message"/>

    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="plain-scroll">
        <VBox fx:id="list" spacing="10"/>
    </ScrollPane>
</VBox>
