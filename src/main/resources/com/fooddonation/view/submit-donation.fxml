<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.fooddonation.controller.SubmitDonationController" fitToWidth="true">
    <VBox styleClass="page" spacing="16" maxWidth="760">
        <GridPane styleClass="form" hgap="12" vgap="10">
            <columnConstraints>
                <ColumnConstraints minWidth="150"/>
                <ColumnConstraints hgrow="ALWAYS"/>
            </columnConstraints>
            <Label text="Donation type" GridPane.rowIndex="0"/>
            <ComboBox fx:id="typeBox" maxWidth="Infinity" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
        </GridPane>

        <!-- shown for the four food types (DON-2, DON-3) -->
        <VBox fx:id="foodFields" spacing="16">
            <Label text="Food" styleClass="section"/>
            <GridPane styleClass="form" hgap="12" vgap="10">
                <columnConstraints>
                    <ColumnConstraints minWidth="150"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                </columnConstraints>
                <Label text="Food name" GridPane.rowIndex="0"/>
                <TextField fx:id="foodNameField" promptText="e.g. Rice and chicken" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                <Label text="Quantity" GridPane.rowIndex="1"/>
                <HBox spacing="8" GridPane.rowIndex="1" GridPane.columnIndex="1">
                    <TextField fx:id="quantityField" promptText="5" HBox.hgrow="ALWAYS"/>
                    <ComboBox fx:id="unitBox" prefWidth="140"/>
                </HBox>
                <Label text="Category" GridPane.rowIndex="2"/>
                <ComboBox fx:id="categoryBox" promptText="Choose a category" maxWidth="Infinity" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                <Label text="Storage" GridPane.rowIndex="3"/>
                <ComboBox fx:id="storageBox" promptText="Choose a storage type" maxWidth="Infinity" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
                <Label text="Expiry / best before" GridPane.rowIndex="4"/>
                <DatePicker fx:id="expiryPicker" maxWidth="Infinity" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
            </GridPane>

            <Label text="Pickup" styleClass="section"/>
            <GridPane styleClass="form" hgap="12" vgap="10">
                <columnConstraints>
                    <ColumnConstraints minWidth="150"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                </columnConstraints>
                <Label text="Day" GridPane.rowIndex="0"/>
                <DatePicker fx:id="pickupDatePicker" maxWidth="Infinity" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                <Label text="Between" GridPane.rowIndex="1"/>
                <HBox spacing="8" alignment="CENTER_LEFT" GridPane.rowIndex="1" GridPane.columnIndex="1">
                    <TextField fx:id="pickupFromField" promptText="10:00" prefWidth="90"/>
                    <Label text="and"/>
                    <TextField fx:id="pickupToField" promptText="12:00" prefWidth="90"/>
                </HBox>
                <Label text="Address" GridPane.rowIndex="2"/>
                <TextField fx:id="pickupAddressField" promptText="Leave empty to use the address in your profile" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
            </GridPane>

            <Label text="Extra services" styleClass="section"/>
            <FlowPane fx:id="addOnBox" hgap="18" vgap="8"/>
        </VBox>

        <!-- shown for money donations (DON-9) -->
        <VBox fx:id="moneyFields" spacing="16">
            <Label text="Money" styleClass="section"/>
            <GridPane styleClass="form" hgap="12" vgap="10">
                <columnConstraints>
                    <ColumnConstraints minWidth="150"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                </columnConstraints>
                <Label text="Amount" GridPane.rowIndex="0"/>
                <TextField fx:id="amountField" promptText="250.00" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
            </GridPane>
            <Label text="The donation is recorded now. Payment is part of Phase 2." styleClass="muted"/>
        </VBox>

        <HBox spacing="10">
            <Button text="Submit donation" defaultButton="true" onAction="#submit" styleClass="primary"/>
            <Button text="Clear" onAction="#clearForm"/>
        </HBox>
        <Label fx:id="message" wrapText="true" styleClass="message"/>
    </VBox>
</ScrollPane>
