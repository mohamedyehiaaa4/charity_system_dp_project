<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.fooddonation.controller.LookupTablesController" styleClass="page" spacing="12" maxWidth="720">
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Table"/>
        <ComboBox fx:id="typeBox" prefWidth="200"/>
    </HBox>
    <TableView fx:id="table" VBox.vgrow="ALWAYS">
        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
        <columns>
            <TableColumn fx:id="idColumn" text="ID" prefWidth="60"/>
            <TableColumn fx:id="nameColumn" text="Name" prefWidth="320"/>
            <TableColumn fx:id="systemColumn" text="System row" prefWidth="120"/>
        </columns>
    </TableView>
    <HBox spacing="10" alignment="CENTER_LEFT">
        <TextField fx:id="nameField" promptText="Name" HBox.hgrow="ALWAYS" onAction="#add"/>
        <Button text="Add" onAction="#add" styleClass="primary"/>
        <Button fx:id="renameButton" text="Rename selected" onAction="#rename"/>
        <Button fx:id="deleteButton" text="Delete selected" onAction="#delete" styleClass="danger"/>
    </HBox>
    <Label text="Protected rows (the five lifecycle statuses) can't be renamed or deleted. A row used by a donation can't be deleted." styleClass="muted" wrapText="true"/>
    <Label fx:id="message" wrapText="true" styleClass="message"/>
</VBox>
