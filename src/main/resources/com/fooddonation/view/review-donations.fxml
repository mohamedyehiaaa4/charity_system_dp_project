<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.fooddonation.controller.ReviewDonationsController" styleClass="page" spacing="16">
    <VBox spacing="2">
        <Label text="Donations" styleClass="page-title"/>
        <Label text="Review incoming donations. The most urgent ones are at the top." styleClass="muted"/>
    </VBox>

    <HBox spacing="14">
        <VBox styleClass="stat" HBox.hgrow="ALWAYS" maxWidth="Infinity">
            <Label text="Waiting for review" styleClass="stat-label"/>
            <Label fx:id="waitingValue" styleClass="stat-value"/>
        </VBox>
        <VBox styleClass="stat" HBox.hgrow="ALWAYS" maxWidth="Infinity">
            <Label text="Approved" styleClass="stat-label"/>
            <Label fx:id="approvedValue" styleClass="stat-value"/>
        </VBox>
        <VBox styleClass="stat" HBox.hgrow="ALWAYS" maxWidth="Infinity">
            <Label text="Picked up" styleClass="stat-label"/>
            <Label fx:id="pickedUpValue" styleClass="stat-value"/>
        </VBox>
        <VBox styleClass="stat, warn" HBox.hgrow="ALWAYS" maxWidth="Infinity">
            <Label text="Expiring within 48 h" styleClass="stat-label"/>
            <Label fx:id="expiringValue" styleClass="stat-value"/>
        </VBox>
        <VBox styleClass="stat" HBox.hgrow="ALWAYS" maxWidth="Infinity">
            <Label text="Money received" styleClass="stat-label"/>
            <Label fx:id="moneyValue" styleClass="stat-value"/>
        </VBox>
    </HBox>

    <VBox styleClass="panel" VBox.vgrow="ALWAYS">
        <HBox styleClass="toolbar">
            <TextField fx:id="searchField" promptText="Search donor or food…" prefWidth="220"/>
            <ComboBox fx:id="statusFilter" prefWidth="150"/>
            <Pane HBox.hgrow="ALWAYS"/>
            <Button fx:id="approveButton" text="Approve" onAction="#approve" styleClass="primary"/>
            <Button fx:id="rejectButton" text="Reject…" onAction="#reject" styleClass="danger"/>
            <Button fx:id="pickedUpButton" text="Mark picked up" onAction="#markPickedUp"/>
            <Button fx:id="deliveredButton" text="Mark delivered" onAction="#markDelivered"/>
            <Button fx:id="receiptButton" text="Receipt" onAction="#showReceipt"/>
        </HBox>
        <TableView fx:id="table" VBox.vgrow="ALWAYS">
            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
            <columns>
                <TableColumn fx:id="idColumn" text="No." prefWidth="50"/>
                <TableColumn fx:id="donorColumn" text="Donor" prefWidth="125"/>
                <TableColumn fx:id="whatColumn" text="Donation" prefWidth="160"/>
                <TableColumn fx:id="extrasColumn" text="Extras" prefWidth="250"/>
                <TableColumn fx:id="priorityColumn" text="Priority" prefWidth="65"/>
                <TableColumn fx:id="statusColumn" text="Status" prefWidth="105"/>
                <TableColumn fx:id="expiryColumn" text="Expiry" prefWidth="95"/>
                <TableColumn fx:id="pickupColumn" text="Pickup" prefWidth="190"/>
            </columns>
        </TableView>
    </VBox>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label fx:id="message" wrapText="true" styleClass="message" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
        <Button text="Check for near expiry now" onAction="#checkExpiry"/>
    </HBox>
</VBox>
