<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<HBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.fooddonation.controller.LoginController">
    <VBox styleClass="brand-panel" prefWidth="420" minWidth="320" alignment="CENTER">
        <Label text="K" styleClass="logo-big"/>
        <Label text="Kheir" styleClass="brand-title"/>
        <Label text="Connecting donors with people in need. Give food or money, and follow every donation from pickup to delivery."
               styleClass="brand-text" wrapText="true" textAlignment="CENTER" maxWidth="320"/>
    </VBox>
    <StackPane styleClass="auth-page" HBox.hgrow="ALWAYS">
        <VBox styleClass="card" maxWidth="380" maxHeight="-Infinity" spacing="12">
            <Label text="Welcome back" styleClass="title"/>
            <Label text="Sign in with your email." styleClass="muted" wrapText="true"/>
            <Label text="Email" styleClass="field-label"/>
            <TextField fx:id="emailField" promptText="you@example.com" onAction="#signIn"/>
            <Button text="Sign in" defaultButton="true" maxWidth="Infinity" onAction="#signIn" styleClass="primary"/>
            <Label text="New here?" styleClass="muted" maxWidth="Infinity" alignment="CENTER"/>
            <Button text="Register as a donor" maxWidth="Infinity" onAction="#register"/>
            <Label fx:id="message" wrapText="true" styleClass="message"/>
        </VBox>
    </StackPane>
</HBox>
