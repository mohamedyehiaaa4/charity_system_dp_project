<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.fooddonation.controller.LoginController" styleClass="auth-page">
    <VBox styleClass="card" maxWidth="420" maxHeight="-Infinity" spacing="14">
        <Label text="Food Donation System" styleClass="title"/>
        <Label text="Sign in with your email. Phase 1 has no passwords." styleClass="muted" wrapText="true"/>
        <Label text="Email" styleClass="field-label"/>
        <TextField fx:id="emailField" promptText="you@example.com" onAction="#signIn"/>
        <Button text="Sign in" defaultButton="true" maxWidth="Infinity" onAction="#signIn" styleClass="primary"/>
        <HBox spacing="10">
            <Button text="Sign in as coordinator" onAction="#useCoordinator"/>
            <Button text="Register as a donor" onAction="#register"/>
        </HBox>
        <Label fx:id="message" wrapText="true" styleClass="message"/>
    </VBox>
</StackPane>
