<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>

<!-- Each tab's content is its own view and controller; this file only arranges them. -->
<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.fooddonation.controller.CoordinatorPanelController">
    <top>
        <HBox styleClass="header" spacing="12">
            <Label text="Coordinator dashboard" styleClass="header-title"/>
            <Pane HBox.hgrow="ALWAYS"/>
            <Label fx:id="userLabel" styleClass="header-user"/>
            <Button text="Sign out" onAction="#signOut"/>
        </HBox>
    </top>
    <center>
        <TabPane fx:id="tabs" tabClosingPolicy="UNAVAILABLE">
            <Tab fx:id="reviewTab" text="Donations">
                <fx:include fx:id="review" source="review-donations.fxml"/>
            </Tab>
            <Tab fx:id="lookupsTab" text="Lookup tables">
                <fx:include fx:id="lookups" source="lookup-tables.fxml"/>
            </Tab>
            <Tab fx:id="inboxTab" text="Inbox">
                <fx:include fx:id="inbox" source="inbox.fxml"/>
            </Tab>
            <Tab fx:id="logTab" text="Email and SMS log">
                <fx:include fx:id="log" source="message-log.fxml"/>
            </Tab>
            <Tab fx:id="profileTab" text="Profile">
                <fx:include fx:id="profile" source="profile.fxml"/>
            </Tab>
        </TabPane>
    </center>
</BorderPane>
