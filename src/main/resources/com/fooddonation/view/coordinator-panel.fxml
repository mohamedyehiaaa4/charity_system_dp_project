<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<!-- Each page's content is its own view and controller; this file only arranges them. -->
<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.fooddonation.controller.CoordinatorPanelController">
    <left>
        <VBox styleClass="sidebar">
            <HBox styleClass="brand">
                <Label text="K" styleClass="logo"/>
                <Label text="Kheir" styleClass="brand-name"/>
            </HBox>
            <VBox fx:id="nav" spacing="4"/>
            <Pane VBox.vgrow="ALWAYS"/>
            <VBox styleClass="sidebar-user">
                <Label fx:id="userName" styleClass="user-name"/>
                <Label fx:id="userEmail" styleClass="user-email"/>
                <Button text="Sign out" onAction="#signOut"/>
            </VBox>
        </VBox>
    </left>
    <center>
        <TabPane fx:id="tabs" tabClosingPolicy="UNAVAILABLE" styleClass="content-tabs">
            <Tab fx:id="reviewTab" text="Donations">
                <fx:include fx:id="review" source="review-donations.fxml"/>
            </Tab>
            <Tab fx:id="lookupsTab" text="Lookup tables">
                <fx:include fx:id="lookups" source="lookup-tables.fxml"/>
            </Tab>
            <Tab fx:id="inboxTab" text="Inbox">
                <fx:include fx:id="inbox" source="inbox.fxml"/>
            </Tab>
            <Tab fx:id="logTab" text="My emails &amp; SMS">
                <fx:include fx:id="log" source="message-log.fxml"/>
            </Tab>
            <Tab fx:id="profileTab" text="Profile">
                <fx:include fx:id="profile" source="profile.fxml"/>
            </Tab>
        </TabPane>
    </center>
</BorderPane>
